digraph R {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.4, pad=0.3, bgcolor="white", label="Figure 3. Reservation Process Flowchart (RegistrationService.reserve)", labelloc=t, fontsize=16];
  node [fontname="Helvetica", fontsize=11, style="filled", fillcolor="#F0E6FA", color="#210B2C", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=10, color="#210B2C"];

  start [label="START", shape=oval, fillcolor="#210B2C", fontcolor=white];
  in [label="Participant chooses an event\nand number of spots", shape=parallelogram];
  q1 [label="Logged in as\nparticipant?", shape=diamond, fillcolor="#FFD166"];
  e1 [label="AuthenticationError\n(401 Please log in first)", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  q2 [label="Quantity is a whole\nnumber >= 1?", shape=diamond, fillcolor="#FFD166"];
  e2 [label="ValidationError\n(400)", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  open [label="Open transaction:\nrepository locks and loads data.json", shape=box, style="rounded,filled"];
  q3 [label="Event exists?", shape=diamond, fillcolor="#FFD166"];
  e3 [label="NotFoundError\n(404)", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  q4 [label="Already reserved\nthis event?", shape=diamond, fillcolor="#FFD166"];
  e4 [label="DuplicateRegistrationError\n(409)", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  q5 [label="Quantity <=\navailable spots?", shape=diamond, fillcolor="#FFD166"];
  e5 [label="EventFullError\n(400 Only N spots are available)", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  mk [label="Create Registration object\n(status = registered)", shape=box, style="rounded,filled"];
  sv [label="Recount reserved spots\nand save data.json", shape=box, style="rounded,filled"];
  ok [label="Return 201:\n\"Your spot has been reserved!\"", shape=parallelogram, fillcolor="#e2f3e8"];
  rb [label="Transaction ends with the error:\nnothing is saved", shape=box, style="rounded,filled", fillcolor="#FFF0C2"];
  end [label="END", shape=oval, fillcolor="#210B2C", fontcolor=white];

  start -> in -> q1;
  q1 -> e1 [label="No"]; q1 -> q2 [label="Yes"];
  q2 -> e2 [label="No"]; q2 -> open [label="Yes"];
  open -> q3; q3 -> e3 [label="No"]; q3 -> q4 [label="Yes"];
  q4 -> e4 [label="Yes"]; q4 -> q5 [label="No"];
  q5 -> e5 [label="No"]; q5 -> mk [label="Yes"];
  mk -> sv -> ok -> end;
  {e3 e4 e5} -> rb; rb -> end; e1 -> end; e2 -> end;
}
