digraph F {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", label="Figure 2. Overall System Flowchart", labelloc=t, fontsize=16];
  node [fontname="Helvetica", fontsize=11, style="filled", fillcolor="#F0E6FA", color="#210B2C", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=10, color="#210B2C"];

  start [label="START", shape=oval, fillcolor="#210B2C", fontcolor=white];
  open  [label="Open the Event Registration website", shape=box, style="rounded,filled"];
  who   [label="Which login?", shape=diamond, fillcolor="#FFD166"];

  psign [label="Participant: Log in\nor Sign up\n(Student ID, name, email, password)", shape=parallelogram];
  pval  [label="Valid and not\nduplicate?", shape=diamond, fillcolor="#FFD166"];
  perr  [label="Show error message\n(ValidationError /\nDuplicateAccountError)", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  pmenu [label="Participant menu:\nDashboard, Browse Events,\nMy Registrations, Profile, Attended", shape=box, style="rounded,filled"];
  pchoice [label="Action?", shape=diamond, fillcolor="#FFD166"];
  browse [label="Browse / search / filter events", shape=box, style="rounded,filled"];
  reserve [label="Reserve a spot\n(see Figure 3)", shape=box, style="rounded,filled,bold"];
  cancel [label="Cancel own reservation\n(not allowed if attended / absent)", shape=box, style="rounded,filled"];

  alogin [label="Admin: enter admin email\nand password", shape=parallelogram];
  aval  [label="Credentials\ncorrect?", shape=diamond, fillcolor="#FFD166"];
  aerr  [label="Show error:\nInvalid administrator credentials", shape=box, style="rounded,filled", fillcolor="#fbe6e3"];
  amenu [label="Admin menu:\nDashboard, Events, Add Event,\nParticipants, Registrations, Attendance", shape=box, style="rounded,filled"];
  achoice [label="Action?", shape=diamond, fillcolor="#FFD166"];
  aevents [label="Add / Edit / Delete event\n(validate; no past date;\ncapacity >= reserved;\nno delete if registrations)", shape=box, style="rounded,filled"];
  aview [label="View / search participants\nand registrations", shape=box, style="rounded,filled"];
  aatt  [label="Mark attendance:\nregistered / attended / absent", shape=box, style="rounded,filled"];

  save [label="Services update the Database object\nand JsonRepository saves data.json", shape=box, style="rounded,filled", fillcolor="#FFF0C2"];
  more [label="Continue?", shape=diamond, fillcolor="#FFD166"];
  logout [label="Log out", shape=box, style="rounded,filled"];
  end [label="END", shape=oval, fillcolor="#210B2C", fontcolor=white];

  start -> open -> who;
  who -> psign [label="Participant"];
  who -> alogin [label="Admin"];

  psign -> pval; pval -> perr [label="No"]; perr -> psign;
  pval -> pmenu [label="Yes"]; pmenu -> pchoice;
  pchoice -> browse [label="Browse"]; pchoice -> reserve [label="Reserve"]; pchoice -> cancel [label="Cancel"];
  browse -> more; reserve -> save; cancel -> save;

  alogin -> aval; aval -> aerr [label="No"]; aerr -> alogin;
  aval -> amenu [label="Yes"]; amenu -> achoice;
  achoice -> aevents [label="Events"]; achoice -> aview [label="View"]; achoice -> aatt [label="Attendance"];
  aevents -> save; aatt -> save; aview -> more;

  save -> more;
  more -> pchoice [label="Yes (participant)", constraint=false, style=dashed];
  more -> achoice [label="Yes (admin)", constraint=false, style=dashed];
  more -> logout [label="No"]; logout -> end;
}
